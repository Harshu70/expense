// 1. Import the Document class from the exact path JAXB created
import iso.std.iso._20022.tech.xsd.camt107.Document; 

import jakarta.xml.bind.JAXBContext;
import jakarta.xml.bind.Unmarshaller;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import java.io.File;
import java.time.LocalDateTime;

@Service
public class Camt107Strategy implements SwiftMessageStrategy {

    private final SwiftMessageRepository repository;
    private final JAXBContext camt107Context;

    public Camt107Strategy(SwiftMessageRepository repository) throws Exception {
        this.repository = repository;
        
        // 2. Initialize the context using the imported Document class
        this.camt107Context = JAXBContext.newInstance(Document.class);
    }

    @Override
    public boolean supports(String messageType) {
        return "camt.107.001.01".equalsIgnoreCase(messageType);
    }

    @Override
    @Transactional
    public void processAndStore(File xmlFile) throws Exception {
        Unmarshaller unmarshaller = camt107Context.createUnmarshaller();
        
        // 3. Cast the unmarshalled object to your specific Document
        Document document = (Document) unmarshaller.unmarshal(xmlFile);

        // 4. Extract details (Use your IDE's autocomplete to see the available getters)
        // Example: String msgId = document.getBkToCstmrStmt().getGrpHdr().getMsgId();
        
        SwiftMessageEntity entity = new SwiftMessageEntity();
        // entity.setMessageId(msgId);
        entity.setMessageType("CAMT.107");
        entity.setCreationDate(LocalDateTime.now());

        repository.save(entity);
    }
}
