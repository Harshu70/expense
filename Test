<plugin>
    <groupId>org.codehaus.mojo</groupId>
    <artifactId>jaxb2-maven-plugin</artifactId>
    <version>3.2.0</version>

    <executions>

        <!-- CAMT 107 V01 -->
        <execution>
            <id>generate-camt107-v01</id>
            <goals>
                <goal>xjc</goal>
            </goals>
            <configuration>
                <sources>
                    <source>
                        ${project.basedir}/src/main/resources/v01
                    </source>
                </sources>

                <packageName>
                    com.yourcompany.camt.v01
                </packageName>

                <outputDirectory>
                    ${project.build.directory}/generated-sources/jaxb/v01
                </outputDirectory>

                <clearOutputDir>false</clearOutputDir>
            </configuration>
        </execution>

        <!-- CAMT 107 V02 -->
        <execution>
            <id>generate-camt107-v02</id>
            <goals>
                <goal>xjc</goal>
            </goals>
            <configuration>
                <sources>
                    <source>
                        ${project.basedir}/src/main/resources/v02
                    </source>
                </sources>

                <packageName>
                    com.yourcompany.camt.v02
                </packageName>

                <outputDirectory>
                    ${project.build.directory}/generated-sources/jaxb/v02
                </outputDirectory>

                <clearOutputDir>false</clearOutputDir>
            </configuration>
        </execution>

    </executions>
</plugin>
