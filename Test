import org.springframework.stereotype.Component;
import org.springframework.util.ResourceUtils;
import java.io.File;
import java.nio.file.Files;
import java.util.List;

@Component
public class SwiftOrchestrator {

    // Spring injects both Camt107Strategy and Camt108Strategy here automatically
    private final List<SwiftMessageStrategy> strategies;

    public SwiftOrchestrator(List<SwiftMessageStrategy> strategies) {
        this.strategies = strategies;
    }

    public void processFileFromResources(String fileName) {
        try {
            // 1. Read file from the resources folder
            File xmlFile = ResourceUtils.getFile("classpath:" + fileName);
            String xmlContent = Files.readString(xmlFile.toPath());

            // 2. Identify the message type (Quick regex or XML stream reader to check namespace)
            String messageType = extractMessageType(xmlContent);

            // 3. Find the matching strategy and process
            SwiftMessageStrategy matchedStrategy = strategies.stream()
                    .filter(strategy -> strategy.supports(messageType))
                    .findFirst()
                    .orElseThrow(() -> new IllegalArgumentException("No strategy found for type: " + messageType));

            matchedStrategy.processAndStore(xmlFile);

        } catch (Exception e) {
            System.err.println("Failed to process file: " + e.getMessage());
        }
    }

    private String extractMessageType(String xmlContent) {
        // In a real app, you would use an XMLStreamReader to grab the xmlns attribute.
        // For simplicity, returning the hardcoded type here.
        if (xmlContent.contains("camt.107")) return "camt.107.001.01";
        if (xmlContent.contains("camt.108")) return "camt.108.001.01";
        return "UNKNOWN";
    }
}
