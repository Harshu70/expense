Pattern pattern = Pattern.compile("\\{4:(.*?)\\-\\}", Pattern.DOTALL);
Matcher matcher = pattern.matcher(swiftMessage);

String block4 = "";
if (matcher.find()) {
    block4 = matcher.group(1);
}

Map<String, String> fields = new LinkedHashMap<>();

Pattern tagPattern =
        Pattern.compile(":(\\d+[A-Z]?):(.*?)(?=:\\d+[A-Z]?:|$)",
                Pattern.DOTALL);

Matcher tagMatcher = tagPattern.matcher(block4);

while (tagMatcher.find()) {
    String tag = tagMatcher.group(1);
    String value = tagMatcher.group(2).trim();

    fields.put(tag, value);
}


Pattern typePattern = Pattern.compile("\\{2:I(\\d{3})");
Matcher typeMatcher = typePattern.matcher(swiftMessage);

String mtType = null;
if (typeMatcher.find()) {
    mtType = typeMatcher.group(1);
}


public class MTMessageDTO {
    private String type;
    private Map<String, String> fields;
}



public MTMessageDTO parse(String swiftMessage) {
    String type = extractType(swiftMessage);
    Map<String, String> fields = extractFields(swiftMessage);

    MTMessageDTO dto = new MTMessageDTO();
    dto.setType(type);
    dto.setFields(fields);

    return dto;
}
