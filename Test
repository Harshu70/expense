public void processXmlPayload(String xmlContent) {
        try {
            String messageType = extractMessageType(xmlContent);

            SwiftMessageStrategy matchedStrategy = strategies.stream()
                    .filter(strategy -> strategy.supports(messageType))
                    .findFirst()
                    .orElseThrow(() -> new IllegalArgumentException("Unsupported SWIFT message type: " + messageType));

            // Pass the string directly to the strategy
            matchedStrategy.processAndStore(xmlContent);

        } catch (Exception e) {
            // In a production app, you might want to re-throw a custom exception here
            // so the REST controller can return a 400 Bad Request or 500 Error
            throw new RuntimeException("Failed to process SWIFT message: " + e.getMessage(), e);
        }
    }
